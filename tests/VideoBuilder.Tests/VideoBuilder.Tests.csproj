<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 のテストは実行ファイルとして作る -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <ProjectReference Include="../../src/VideoBuilder.Core/VideoBuilder.Core.csproj" />
    <ProjectReference Include="../../src/VideoBuilder.Editing/VideoBuilder.Editing.csproj" />
    <ProjectReference Include="../../src/VideoBuilder.Media/VideoBuilder.Media.csproj" />
    <ProjectReference Include="../../src/VideoBuilder.Rendering/VideoBuilder.Rendering.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Assets/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
